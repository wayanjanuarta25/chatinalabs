# ==============================================================================
# chatINALabs AI — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development or configure these variables
# in your production hosting platform (Vercel, Railway, Render, Docker, etc.).

# ------------------------------------------------------------------------------
# 1. Supabase Credentials (Required)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# ------------------------------------------------------------------------------
# 2. Public App / Site URL (Recommended for Production Auth Redirects)
# ------------------------------------------------------------------------------
# The canonical public URL of your application (e.g., https://chatina.yourdomain.com)
# Used by auth callback handlers to prevent redirect loops behind reverse proxies.
NEXT_PUBLIC_APP_URL=https://your-app-domain.com

# ------------------------------------------------------------------------------
# 3. AI Providers Configuration
# ------------------------------------------------------------------------------
# Primary AI Provider Selection ('kelontongai' | 'openai' | 'anthropic' | 'simulated')
AI_PROVIDER=kelontongai

# KelontongAI API Credentials (OpenAI-compatible endpoint)
# Endpoint: https://api.kelontongai.id/v1/chat/completions
# Default Model: gpt-5.6-sol
KELONTONGAI_API_KEY=your_kelontongai_api_key
KELONTONGAI_BASE_URL=https://api.kelontongai.id/v1

# OpenAI API Key (Required if using OpenAI models or text-embedding-3-small embeddings)
# In development, a placeholder will fall back to simulated provider.
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: Custom OpenAI Base URL (for LiteLLM, Ollama, Azure OpenAI, or custom reverse proxies)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Anthropic API Key (if Claude models are enabled)
# ANTHROPIC_API_KEY=your_anthropic_api_key
